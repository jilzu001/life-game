{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "worldIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
        },
        {
          "pattern": "^images\\/.+\\.(svg|webp)$"
        }
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "isDefault": {
      "type": "boolean"
    },
    "conditions": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "worldIds",
    "title",
    "description",
    "image",
    "priority",
    "isDefault"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "stat"
                },
                "key": {
                  "type": "string",
                  "enum": [
                    "survival",
                    "influence",
                    "intelligence",
                    "freedom",
                    "chaos"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "gte",
                    "lte",
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "flag"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "tag",
                    "item"
                  ]
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "world",
                    "entity",
                    "location",
                    "trait",
                    "flaw"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "type",
                "operator",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "event"
                },
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "eventId",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "choice"
                },
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "choiceId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "eventId",
                "choiceId",
                "operator",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
