{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "worldIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "entityIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "entityTags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "birth",
        "awakening",
        "growth",
        "crisis",
        "transition",
        "climax",
        "conclusion",
        "any"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
        },
        {
          "pattern": "^images\\/.+\\.(svg|webp)$"
        }
      ]
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "conditions": {
      "$ref": "#/$defs/__schema0"
    },
    "chaosWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "isFallback": {
      "type": "boolean"
    },
    "revealsFate": {
      "type": "boolean"
    },
    "choices": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "$ref": "#/$defs/__schema0"
          },
          "resultText": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "addStat"
                        },
                        "key": {
                          "type": "string",
                          "enum": [
                            "survival",
                            "influence",
                            "intelligence",
                            "freedom",
                            "chaos"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "op",
                        "key",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "setStat"
                        },
                        "key": {
                          "type": "string",
                          "enum": [
                            "survival",
                            "influence",
                            "intelligence",
                            "freedom",
                            "chaos"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "op",
                        "key",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "setFlag"
                        },
                        "key": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "op",
                        "key",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "op": {
                          "type": "string",
                          "enum": [
                            "addTag",
                            "removeTag",
                            "addItem",
                            "removeItem"
                          ]
                        },
                        "key": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        }
                      },
                      "required": [
                        "op",
                        "key"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "transformEntity"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "op",
                    "entityId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "nextEventId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "conditions": {
                  "$ref": "#/$defs/__schema0"
                },
                "nextEventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "conditions",
                "nextEventId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "text",
          "resultText",
          "effects",
          "branches"
        ],
        "additionalProperties": false
      }
    },
    "nextEventId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conditions": {
            "$ref": "#/$defs/__schema0"
          },
          "nextEventId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "conditions",
          "nextEventId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "worldIds",
    "entityIds",
    "entityTags",
    "stage",
    "title",
    "description",
    "image",
    "weight",
    "choices",
    "branches"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "stat"
                },
                "key": {
                  "type": "string",
                  "enum": [
                    "survival",
                    "influence",
                    "intelligence",
                    "freedom",
                    "chaos"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "gte",
                    "lte",
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "flag"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "tag",
                    "item"
                  ]
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "key",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "world",
                    "entity",
                    "location",
                    "trait",
                    "flaw"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "type",
                "operator",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "event"
                },
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "eventId",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "choice"
                },
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "choiceId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals"
                  ]
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "eventId",
                "choiceId",
                "operator",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
