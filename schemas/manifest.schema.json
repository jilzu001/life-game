{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "worlds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
          },
          {
            "pattern": "\\.json$"
          }
        ]
      }
    },
    "entities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
          },
          {
            "pattern": "\\.json$"
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
          },
          {
            "pattern": "\\.json$"
          }
        ]
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
          },
          {
            "pattern": "\\.json$"
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "worlds",
    "entities",
    "events",
    "endings"
  ],
  "additionalProperties": false
}
