{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*\\.[a-zA-Z0-9]+$"
        },
        {
          "pattern": "^images\\/.+\\.(svg|webp)$"
        }
      ]
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "entityIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "image",
    "weight",
    "entityIds"
  ],
  "additionalProperties": false
}
