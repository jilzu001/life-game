{
  "name": "life-game",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "schema:generate": "node scripts/generate-schema.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "validate:dist": "node scripts/validate-dist.mjs",
    "verify": "npm run validate:content && npm run test && npm run build && npm run validate:dist"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
